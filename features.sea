-- features.sea — Feature extraction for OCR character patches.
-- Produces a 384-dimensional float_array combining:
--   - 10x14 tight normalized zoning grid (140 dims)
--   - Horizontal & vertical ink projections (24 dims)
--   - Left & right contour profiles (28 dims)
--   - Horizontal & vertical stroke transition / crossing counts (24 dims)
--   - Geometric, topological, and line-relative features (8 dims)
--   - Stroke directions: gradient orientations in 8 bins over 4x5 zones of
--     a 16x20 gray copy (160 dims), which bear a stroke a little higher or
--     thinner than the learned one better than the ink grid does

local preprocess = require("./preprocess")

local M = {}

const GRID_W = 10
const GRID_H = 14
const BASE_DIM = 224
const DIR_W = 16
const DIR_H = 20
const DIR_CELL = 4
const DIR_BINS = 8
const DIR_DIM = (DIR_W // DIR_CELL) * (DIR_H // DIR_CELL) * DIR_BINS
const FEAT_DIM = BASE_DIM + DIR_DIM
-- the weight of the direction block against the others (its norm)
M.DIR_WEIGHT = 8.0
-- the weight of the hole count (an e has one, a c none)
const HOLE_W = 2.0

M.GRID_W = GRID_W
M.GRID_H = GRID_H
M.FEAT_DIM = FEAT_DIM

-- Count enclosed background holes (4-connected background components not touching the border)
local function count_holes(grid_img, thr)
    local gw = grid_img.width
    local gh = grid_img.height
    -- Pad with a 1-pixel white border so exterior background is a single connected component
    local pw = gw + 2
    local ph = gh + 2
    local vis = int_array(pw * ph)
    for i = 0, pw * ph - 1 do vis[] = 0 end

    for y = 0, gh - 1 do
        for x = 0, gw - 1 do
            if grid_img.data[y * gw + x] < thr then
                vis[(y + 1) * pw + (x + 1)] = 1 -- mark ink as blocked
            end
        end
    end

    local q = int_array(pw * ph)
    for i = 0, pw * ph - 1 do q[] = 0 end

    local function flood(start_idx)
        local head = 0
        local tail = 0
        vis[start_idx] = 2
        q[tail] = start_idx
        tail += 1
        local count = 0
        while head < tail do
            local cur = q[head]
            head += 1
            count += 1
            local cy = cur // pw
            local cx = cur % pw
            if cx > 0 and vis[cur - 1] == 0 then
                vis[cur - 1] = 2
                q[tail] = cur - 1
                tail += 1
            end
            if cx + 1 < pw and vis[cur + 1] == 0 then
                vis[cur + 1] = 2
                q[tail] = cur + 1
                tail += 1
            end
            if cy > 0 and vis[cur - pw] == 0 then
                vis[cur - pw] = 2
                q[tail] = cur - pw
                tail += 1
            end
            if cy + 1 < ph and vis[cur + pw] == 0 then
                vis[cur + pw] = 2
                q[tail] = cur + pw
                tail += 1
            end
        end
        return count
    end

    -- Flood exterior background from (0, 0)
    flood(0)

    local holes = 0
    for i = 0, pw * ph - 1 do
        if vis[i] == 0 then
            local area = flood(i)
            if area >= 2 then
                holes += 1
            end
        end
    end
    return holes
end

-- the stroke direction histograms of a trimmed patch, appended to feat:
-- Sobel gradients of a 16x20 gray copy, each pixel's magnitude shared by
-- the two nearest of 8 orientations, summed over 4x4 cells (each pixel
-- shared by the 4 nearest cell centres), L2-normalized and
-- scaled by M.DIR_WEIGHT
local function add_directions(feat, trimmed)
    local g = preprocess.resize(trimmed, DIR_W, DIR_H)
    local d = g.data
    local zones_x = DIR_W // DIR_CELL
    local zones_y = DIR_H // DIR_CELL
    -- the copy with a white border, so the 3x3 neighbourhood needs no checks
    local pw = DIR_W + 2
    local pad = float_array((DIR_W + 2) * (DIR_H + 2))
    for i = 0, pw * (DIR_H + 2) - 1 do pad[] = 255.0 end
    for y = 0, DIR_H - 1 do
        for x = 0, DIR_W - 1 do pad[(y + 1) * pw + x + 1] = d[y * DIR_W + x] * 1.0 end
    end
    -- the two zones a column / row shares its votes with (offsets into the
    -- histogram) and their weights; at the edges the missing one weighs 0
    local function shares(n, zones, stride)
        local z0s = int_array(n)
        local z1s = int_array(n)
        local w0s = float_array(n)
        local w1s = float_array(n)
        for i = 0, n - 1 do
            local z = (i + 0.5) / DIR_CELL - 0.5
            local z0 = math.floor(z)
            local f = z - z0
            local a = math.max(0, z0)
            local b = math.min(zones - 1, z0 + 1)
            z0s[] = a * stride
            z1s[] = b * stride
            w0s[] = z0 >= 0 and 1.0 - f or 0.0
            w1s[] = z0 + 1 < zones and f or 0.0
        end
        return z0s, z1s, w0s, w1s
    end
    local x0s, x1s, wx0s, wx1s = shares(DIR_W, zones_x, DIR_BINS)
    local y0s, y1s, wy0s, wy1s = shares(DIR_H, zones_y, zones_x * DIR_BINS)
    local hist = float_array(DIR_DIM)
    hist[DIR_DIM - 1] = 0.0
    local two_pi = 2.0 * math.pi
    for y = 0, DIR_H - 1 do
        local ya = y0s[y]
        local yb = y1s[y]
        local wya = wy0s[y]
        local wyb = wy1s[y]
        local up = y * pw
        local mid = up + pw
        local dn = mid + pw
        for x = 0, DIR_W - 1 do
            local gx = (pad[up + x + 2] + 2.0 * pad[mid + x + 2] + pad[dn + x + 2]) -
                (pad[up + x] + 2.0 * pad[mid + x] + pad[dn + x])
            local gy = (pad[dn + x] + 2.0 * pad[dn + x + 1] + pad[dn + x + 2]) -
                (pad[up + x] + 2.0 * pad[up + x + 1] + pad[up + x + 2])
            local mag = math.sqrt(gx * gx + gy * gy)
            if mag > 1e-6 then
                local a = math.atan(gy, gx)
                if a < 0 then a += two_pi end
                local pos = a / two_pi * DIR_BINS
                local b0 = math.floor(pos)
                local f = pos - b0
                b0 = b0 % DIR_BINS
                local b1 = (b0 + 1) % DIR_BINS
                local m0 = mag * (1.0 - f)
                local m1 = mag * f
                -- shared by the 4 nearest zone centres: a stroke a little
                -- higher (the bar of an e) still lands in the same zones
                local xa = x0s[x]
                local xb = x1s[x]
                local wxa = wx0s[x]
                local wxb = wx1s[x]
                local base = ya + xa
                local wt = wya * wxa
                hist[base + b0] += m0 * wt
                hist[base + b1] += m1 * wt
                base = ya + xb
                wt = wya * wxb
                hist[base + b0] += m0 * wt
                hist[base + b1] += m1 * wt
                base = yb + xa
                wt = wyb * wxa
                hist[base + b0] += m0 * wt
                hist[base + b1] += m1 * wt
                base = yb + xb
                wt = wyb * wxb
                hist[base + b0] += m0 * wt
                hist[base + b1] += m1 * wt
            end
        end
    end
    local norm = 0.0
    for i = 0, DIR_DIM - 1 do norm += hist[i] * hist[i] end
    local k = norm > 1e-12 and M.DIR_WEIGHT / math.sqrt(norm) or 0.0
    for i = 0, DIR_DIM - 1 do feat[] = hist[i] * k end
end

-- features.extract(char_info_or_img [, opts]) → float_array(FEAT_DIM)
-- Accepts either a segmented char descriptor `{ patch, bbox, rel_top, rel_bottom, rel_height, aspect }`
-- or a raw `Image` object.
function M.extract(item, opts)
    opts = opts or {}
    local patch = item.patch or item
    local thr = opts.threshold or 150

    local trimmed, tight_box = preprocess.trim(patch, {threshold = thr})
    if tight_box.w == 0 or tight_box.h == 0 then
        local zero_vec = float_array(FEAT_DIM)
        for _ = 0, FEAT_DIM - 1 do zero_vec[] = 0.0 end
        return zero_vec
    end

    local aspect = item.aspect or (tight_box.w / (math.max(1, tight_box.h) * 1.0))
    local rel_top = item.rel_top
    local rel_bottom = item.rel_bottom
    local rel_height = item.rel_height

    -- If extracted from a standalone glyph image without line context, infer nominal line metrics
    -- from the glyph's own canvas or aspect ratio when possible.
    if rel_top == nil then
        if patch.height > tight_box.h + 2 then
            rel_top = tight_box.y / (patch.height * 1.0)
            rel_bottom = (tight_box.y + tight_box.h) / (patch.height * 1.0)
            rel_height = tight_box.h / (patch.height * 1.0)
        else
            rel_top = 0.0
            rel_bottom = 1.0
            rel_height = 1.0
        end
    end

    local norm_img = preprocess.resize(trimmed, GRID_W, GRID_H)
    local feat = float_array(FEAT_DIM)

    -- 1. 10x14 normalized pixel ink density (140 dims)
    local total_ink = 0.0
    local top_ink = 0.0
    local bot_ink = 0.0
    local left_ink = 0.0
    local right_ink = 0.0
    local center_ink = 0.0

    for y = 0, GRID_H - 1 do
        for x = 0, GRID_W - 1 do
            local v = (255.0 - norm_img.data[y * GRID_W + x]) / 255.0
            feat[] = v
            total_ink += v
            if y < GRID_H // 2 then top_ink += v else bot_ink += v end
            if x < GRID_W // 2 then left_ink += v else right_ink += v end
            if x >= 3 and x <= 6 and y >= 4 and y <= 9 then
                center_ink += v
            end
        end
    end

    -- 2. Horizontal projection (14 dims) & Vertical projection (10 dims) = 24 dims
    for y = 0, GRID_H - 1 do
        local rsum = 0.0
        for x = 0, GRID_W - 1 do
            rsum += (255.0 - norm_img.data[y * GRID_W + x]) / 255.0
        end
        feat[] = rsum / GRID_W
    end
    for x = 0, GRID_W - 1 do
        local csum = 0.0
        for y = 0, GRID_H - 1 do
            csum += (255.0 - norm_img.data[y * GRID_W + x]) / 255.0
        end
        feat[] = csum / GRID_H
    end

    -- 3. Left & Right outer contour profiles (14 + 14 = 28 dims)
    for y = 0, GRID_H - 1 do
        local first_x = GRID_W
        local last_x = -1
        for x = 0, GRID_W - 1 do
            if norm_img.data[y * GRID_W + x] < thr then
                if first_x == GRID_W then first_x = x end
                last_x = x
            end
        end
        feat[] = first_x / (GRID_W * 1.0)
        feat[] = (last_x >= 0) and ((GRID_W - 1 - last_x) / (GRID_W * 1.0)) or 1.0
    end

    -- 4. Horizontal & Vertical stroke crossings (14 + 10 = 24 dims)
    for y = 0, GRID_H - 1 do
        local crossings = 0
        local in_ink = false
        for x = 0, GRID_W - 1 do
            local is_dark = norm_img.data[y * GRID_W + x] < thr
            if is_dark and not in_ink then
                crossings += 1
                in_ink = true
            elseif not is_dark then
                in_ink = false
            end
        end
        feat[] = crossings / 3.0
    end
    for x = 0, GRID_W - 1 do
        local crossings = 0
        local in_ink = false
        for y = 0, GRID_H - 1 do
            local is_dark = norm_img.data[y * GRID_W + x] < thr
            if is_dark and not in_ink then
                crossings += 1
                in_ink = true
            elseif not is_dark then
                in_ink = false
            end
        end
        feat[] = crossings / 4.0
    end

    -- 5. Geometric, topological & line-context features (8 dims, scaled to match grid energy)
    local holes = count_holes(norm_img, thr)
    local ink_norm = math.max(1.0, total_ink)
    feat[] = math.min(2.0, aspect) * 1.5
    feat[] = (1.0 / math.max(0.2, math.min(3.0, aspect))) * 0.8
    feat[] = rel_top * 2.5
    feat[] = rel_bottom * 1.5
    feat[] = rel_height * 2.5
    feat[] = (top_ink - bot_ink) / ink_norm * 1.5
    feat[] = (left_ink - right_ink) / ink_norm * 1.5
    feat[] = (holes * HOLE_W) + (center_ink / 24.0) * 0.5

    add_directions(feat, trimmed)
    return feat
end

-- features.cosine(a, b) → float in [-1, 1]
function M.cosine(a, b)
    local dot = 0.0
    local na = 0.0
    local nb = 0.0
    local n = len(a)
    for i = 0, n - 1 do
        local va = a[i]
        local vb = b[i]
        dot += va * vb
        na += va * va
        nb += vb * vb
    end
    if na <= 1e-12 or nb <= 1e-12 then
        return 0.0
    end
    return dot / math.sqrt(na * nb)
end

return M
