-- tools/gen_glyphs.sea — writes glyphs.sea: pre-rasterized glyphs of common
-- fonts (sans, serif, mono) for the recognizer's prototypes, Portuguese
-- accented letters included. Each glyph is a cell as tall as the font's line
-- (ascender to descender, the baseline at the same row) and as wide as the
-- glyph's advance; "#" is ink (anti-aliased coverage of half or more).
--
-- The rasterizing is done by libs/truetype (pure Sea), from fonts installed
-- in /usr/share/fonts. Run from the repository: sea tools/gen_glyphs.sea
local truetype = require("../../sea_vm/libs/truetype/truetype")
local image = require("../../sea_vm/libs/image/image")

-- the sizes the glyphs are drawn at: the first under the font's name, any
-- other as "<name>_<size>" (small text is enlarged before it is read, so
-- glyphs drawn small did not help)
local SIZES = [22]
local F = "/usr/share/fonts/truetype/"
local FONTS = [
    ["dejavu_sans_mono", F .. "dejavu/DejaVuSansMono.ttf"],
    ["dejavu_sans", F .. "dejavu/DejaVuSans.ttf"],
    ["dejavu_sans_bold", F .. "dejavu/DejaVuSans-Bold.ttf"],
    ["dejavu_serif", F .. "dejavu/DejaVuSerif.ttf"],
    ["liberation_sans", F .. "liberation/LiberationSans-Regular.ttf"],
    ["liberation_serif", F .. "liberation/LiberationSerif-Regular.ttf"],
    ["liberation_sans_bold", F .. "liberation/LiberationSans-Bold.ttf"],
    ["liberation_mono", F .. "liberation/LiberationMono-Regular.ttf"],
    ["noto_sans", F .. "noto/NotoSans-Regular.ttf"],
    ["noto_serif", F .. "noto/NotoSerif-Regular.ttf"],
    ["ubuntu", F .. "ubuntu/Ubuntu-R.ttf"],
]
local BASE = "!()+,-./0123456789:=?ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
local EXTRA = "$%&*#@;'\"_"
local ACCENTS = "áàâãäéèêëíìîïóòôõöúùûüçñÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇÑºª"
local CHARS = utf8.chars(BASE .. EXTRA .. ACCENTS)

-- the rows of one glyph: a cell as tall as the line, 2 pixels of margin on
-- each side of the advance
local function glyph_rows(font, ch, size)
    local m = font:metrics(size)
    local w = math.max(1, math.round(font:text_width(ch, size)))
    local img = image.new(w + 4, m.height, 255)
    font:draw(img, ch, 2, m.ascent, size)
    return string.splitlines(img:to_ascii({threshold = 128, dark = "#", light = "."}))
end

local out = [
    "-- glyphs.sea — generated by tools/gen_glyphs.sea (libs/truetype, sizes " .. string.join(SIZES, " and ") .. "): do not edit.",
    "-- Fonts: DejaVu (Bitstream Vera license), Liberation and Noto (SIL Open Font License), Ubuntu (Ubuntu Font Licence).",
    "-- M[name] = {height = rows, glyphs = {[char] = [rows]}}",
    "local M = {}",
]
for _, f in FONTS do
    local font = truetype.load(f[1])?
    for _, size in SIZES do
        local name = size == SIZES[0] and f[0] or `${f[0]}_${size}`
        local height = 0
        out[] = `M.${name} = {}`
        out[] = `M.${name}.glyphs = {}`
        for _, ch in CHARS do
            local rows = glyph_rows(font, ch, size)
            height = len(rows)
            local key = ch == "\"" and "\\\"" or (ch == "\\" and "\\\\" or ch)
            local quoted = []
            for _, row in rows do quoted[] = "\"" .. row .. "\"" end
            out[] = `M.${name}.glyphs["${key}"] = [${string.join(quoted, ", ")}]`
        end
        out[] = `M.${name}.height = ${height}`
    end
end
out[] = "return M"
fs.write("glyphs.sea", string.join(out, "\n") .. "\n")?
print(`glyphs.sea: ${len(FONTS)} fonts x ${len(SIZES)} sizes x ${len(CHARS)} characters`)
