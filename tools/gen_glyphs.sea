-- tools/gen_glyphs.sea — writes glyphs.sea: pre-rasterized glyphs of common
-- fonts (sans, serif, mono) for the recognizer's prototypes, Portuguese
-- accented letters included. Each glyph is a cell as tall as the font's line
-- (ascender to descender, the baseline at the same row) and as wide as the
-- glyph's advance; "#" is ink (anti-aliased coverage of half or more).
--
-- The rasterizing is done by PIL (python3 -c), from fonts installed in
-- /usr/share/fonts. Run from the repository: sea tools/gen_glyphs.sea
local SIZE = 22
local F = "/usr/share/fonts/truetype/"
local FONTS = [
    ["dejavu_sans_mono", F .. "dejavu/DejaVuSansMono.ttf"],
    ["dejavu_sans", F .. "dejavu/DejaVuSans.ttf"],
    ["dejavu_sans_bold", F .. "dejavu/DejaVuSans-Bold.ttf"],
    ["dejavu_serif", F .. "dejavu/DejaVuSerif.ttf"],
    ["liberation_sans", F .. "liberation/LiberationSans-Regular.ttf"],
    ["liberation_serif", F .. "liberation/LiberationSerif-Regular.ttf"],
    ["liberation_sans_bold", F .. "liberation/LiberationSans-Bold.ttf"],
    ["liberation_mono", F .. "liberation/LiberationMono-Regular.ttf"],
    ["noto_sans", F .. "noto/NotoSans-Regular.ttf"],
    ["noto_serif", F .. "noto/NotoSerif-Regular.ttf"],
    ["ubuntu", F .. "ubuntu/Ubuntu-R.ttf"],
]
local BASE = "!()+,-./0123456789:=?ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
local EXTRA = "$%&*#@;'\"_"
local ACCENTS = "áàâãäéèêëíìîïóòôõöúùûüçñÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇÑºª"
local CHARS = utf8.chars(BASE .. EXTRA .. ACCENTS)

-- prints, per character, "<char>\t<row>|<row>|..." for one font
local PY = [[
import sys
from PIL import Image, ImageDraw, ImageFont
path, size = sys.argv[1], int(sys.argv[2])
chars = sys.stdin.read().split("\n")
f = ImageFont.truetype(path, size)
ascent, descent = f.getmetrics()
h = ascent + descent
for ch in chars:
    if not ch:
        continue
    w = max(1, int(round(f.getlength(ch))))
    im = Image.new("L", (w + 4, h), 255)
    ImageDraw.Draw(im).text((2, 0), ch, font=f, fill=0)
    rows = []
    for y in range(h):
        rows.append("".join("#" if im.getpixel((x, y)) < 128 else "." for x in range(w + 4)))
    sys.stdout.write(ch + "\t" + "|".join(rows) + "\n")
]]

local out = [
    "-- glyphs.sea — generated by tools/gen_glyphs.sea (PIL, size " .. tostring(SIZE) .. "): do not edit.",
    "-- Fonts: DejaVu (Bitstream Vera license), Liberation and Noto (SIL Open Font License), Ubuntu (Ubuntu Font Licence).",
    "-- M[name] = {height = rows, glyphs = {[char] = [rows]}}",
    "local M = {}",
]
for _, f in FONTS do
    local r = process.run(["python3", "-c", PY, f[1], tostring(SIZE)], {stdin = string.join(CHARS, "\n")})?
    if r.code ~= 0 then return error(`gen_glyphs: ${f[0]}: ${r.stderr}`) end
    local height = 0
    out[] = `M.${f[0]} = {}`
    out[] = `M.${f[0]}.glyphs = {}`
    for _, line in string.splitlines(r.stdout) do
        local tab = string.find(line, "\t")
        local ch = string.sub(line, 1, tab - 1)
        local rows = string.split(string.sub(line, tab + 1), "|")
        height = len(rows)
        local key = ch == "\"" and "\\\"" or (ch == "\\" and "\\\\" or ch)
        local quoted = []
        for _, row in rows do quoted[] = "\"" .. row .. "\"" end
        out[] = `M.${f[0]}.glyphs["${key}"] = [${string.join(quoted, ", ")}]`
    end
    out[] = `M.${f[0]}.height = ${height}`
end
out[] = "return M"
fs.write("glyphs.sea", string.join(out, "\n") .. "\n")?
print(`glyphs.sea: ${len(FONTS)} fonts x ${len(CHARS)} characters`)
