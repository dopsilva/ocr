-- ocr.sea — Pure Sea OCR Library (with `libs/tensor` neural acceleration).
--
-- High-level API:
--   ocr.read(source [, opts])      → string|error
--   ocr.recognize(source [, opts]) → { text, confidence, lines, words, chars }|error
--   ocr.new_engine([opts])         → Engine instance
--
-- Submodules:
--   ocr.image       — PNG, BMP, PGM/PPM/PBM, ASCII image loading & saving
--   ocr.preprocess  — Grayscale, auto-invert, Otsu & adaptive binarize, denoise, morph, deskew, crop, resize
--   ocr.segment     — Line, word, and character segmentation with bounding boxes
--   ocr.features    — 224-dim structural, contour, projection & topological feature extractor
--   ocr.font        — Built-in 5x7 font, custom font builder, and text-to-image renderer
--   ocr.model       — Template + Tensor MLP classifier, custom training & persistence

local image = require("../sea_vm/libs/image/image")
local preprocess = require("./preprocess")
local segment = require("./segment")
local features = require("./features")
local font = require("./font")
local model = require("./model")
local context = require("./context")
local accents = require("./accents")

local M = {}

M.image = image
M.preprocess = preprocess
M.segment = segment
M.features = features
M.font = font
M.model = model
M.context = context
M.accents = accents

-- the labels of a model without accents (one byte each), as a whitelist
local function base_whitelist(mdl)
    local out = []
    for _, l in mdl.labels do
        if len(l) == 1 then out[] = l end
    end
    return string.join(out, "")
end

-- a character: a letter with a mark above it is read as body + mark
-- (accents.sea); anything else as a whole glyph
local function classify_char(mdl, img, ch_info, opts)
    local copts = {mode = opts.mode, whitelist = opts.whitelist, top_k = opts.top_k or 3}
    if opts.accents ~= false then
        local body, marks = accents.split(ch_info)
        if body ~= nil then
            local bopts = {mode = opts.mode, whitelist = opts.whitelist or base_whitelist(mdl), top_k = copts.top_k}
            local bpred = mdl:classify(accents.body_info(ch_info, body, img), bopts)?
            local c = accents.compose(bpred.char, accents.mark_kind(img, marks))
            if c ~= nil then
                local out = {}
                out.char = c
                out.confidence = bpred.confidence
                out.candidates = [{char = c, confidence = bpred.confidence}]
                return out
            end
        end
    end
    return mdl:classify(ch_info, copts)
end

local STROKE = {I = true, l = true, ["1"] = true, ["|"] = true, i = true, j = true, J = true, ["!"] = true, ["'"] = true, ["í"] = true, ["ì"] = true, ["î"] = true, ["ï"] = true, ["Í"] = true, ["Ì"] = true, ["Î"] = true, ["Ï"] = true, ["("] = true, [")"] = true, ["/"] = true}
local X_HEIGHT = {m = true, n = true, u = true, w = true, r = true, v = true}
local STEM = {I = true, l = true, ["1"] = true, ["|"] = true}
-- what a cut through a letter leaves, never a character of its own
local PUNCT = {
    ["."] = true, [","] = true, ["-"] = true, ["="] = true, [":"] = true, [";"] = true, _ = true,
    ["'"] = true, ["\""] = true, ["*"] = true, ["+"] = true, ["º"] = true, ["ª"] = true,
}
-- read_word: a piece is cut when read with less confidence than CUT_CONF
-- and WIDE times the usual width of the line; each character costs
-- CHAR_COST × that width, a stroke or a mark made by a cut STROKE_COST × its own
const WIDE = 1.3
const CUT_CONF = 0.97
const CHAR_COST = 0.04
const STROKE_COST = 0.08

-- the columns of a piece where it may be two touching characters: the
-- least ink (preferring the middle), at most `max_cuts`, apart from each
-- other and from the edges
local function cut_columns(img, b, thr, max_cuts, min_gap)
    local cols = []
    for dx = 2, b.w - 3 do
        local ink = 0
        for y = b.y, b.y + b.h - 1 do
            if img.data[y * img.width + b.x + dx] < thr then ink += 1 end
        end
        cols[] = [dx, (ink + 1) * (1.0 + 1.5 * math.abs(dx / (b.w * 1.0) - 0.5))]
    end
    sort.sort(cols, function(p, q) return p[1] < q[1] end)
    -- the middle always: two touching characters of one width meet there
    local cuts = [b.w // 2]
    for _, c in cols do
        if len(cuts) >= max_cuts then break end
        local far = c[0] >= min_gap and b.w - c[0] >= min_gap
        for _, d in cuts do
            if math.abs(d - c[0]) < min_gap then far = false end
        end
        if far then cuts[] = c[0] end
    end
    sort.sort(cuts)
    return cuts
end

-- a word read by recognition: wide pieces read with little confidence are
-- cut into slices at their ink valleys, and the slices are grouped again
-- (up to 4 a character) the way whose characters read best: the sum over
-- characters of width × confidence, less a cost for each character. A whole
-- piece keeps its own reading (accents included); a lone stroke made by a
-- cut is what any cut of m, n, u or w leaves, so it costs more, but for a 1
-- beside a digit ("10") or in a piece too tall for the x-height letter it
-- was read as ("IN" read as m). → [ {pred, info} ]
local function read_word(mdl, img, chars, opts, ref_w)
    local thr = opts.threshold or 128
    local atoms = []
    for pi, ch in chars do
        local pred = classify_char(mdl, img, ch, opts)?
        local b = ch.bbox
        local line_h = ch.line_height
        local cuts = []
        if opts.split_touching ~= false and pred.confidence < CUT_CONF and b.w >= 6 and b.w >= b.h * 0.7 and
            b.w >= ref_w * WIDE and
            b.h >= line_h * 0.4 then
            cuts = cut_columns(img, b, thr, 3, math.max(2, line_h // 8))
        end
        local implausible = X_HEIGHT[pred.char] and b.h > line_h * 0.62
        local x0 = 0
        local edges = list.concat(cuts, [b.w])
        for k, x1 in edges do
            atoms[] = {
                piece = pi, first = k == 0, last = k == len(edges) - 1, x = b.x + x0, w = x1 - x0, y = b.y, h = b.h,
                pred = pred, info = ch, implausible = implausible,
            }
            x0 = x1
        end
    end
    local n = len(atoms)

    local pen = CHAR_COST * ref_w
    local best = [0.0]
    local from = [-1]
    local reading = [nil]
    for j = 1, n do
        best[] = -1e18
        from[] = -1
        reading[] = nil
        for i = math.max(0, j - 4), j - 1 do
            local a = atoms[i]
            local z = atoms[j - 1]
            local whole = a.piece == z.piece and a.first and z.last
            local x0 = a.x
            local x1 = z.x + z.w
            local line_h = a.info.line_height
            -- pieces joined into one character: where a stroke broke ("0"
            -- read as "(" and the start of the next piece), so one side must
            -- be a slice cut from a piece, across a small gap; at a cost.
            -- Two whole pieces never join ("-1" would read as 4)
            local joins = 0
            local joinable = true
            for k = i + 1, j - 1 do
                local l = atoms[k - 1]
                local r = atoms[k]
                if r.piece ~= l.piece then
                    joins += 1
                    local gap = r.x - (l.x + l.w)
                    local sliced = not (l.first and l.last) or not (r.first and r.last)
                    if not sliced or gap > math.max(1, line_h // 12) then joinable = false end
                end
            end
            if joinable and (whole or x1 - x0 <= line_h * 1.6) then
                local pred = nil
                local info = nil
                if whole then
                    pred = a.pred
                    info = a.info
                else
                    local y0 = a.y
                    local y1 = a.y + a.h
                    for k = i, j - 1 do
                        y0 = math.min(y0, atoms[k].y)
                        y1 = math.max(y1, atoms[k].y + atoms[k].h)
                    end
                    info = segment.char_info(img, {x = x0, y = y0, w = x1 - x0, h = y1 - y0}, a.info.line_top, line_h, thr)
                    pred = classify_char(mdl, img, info, opts)?
                end
                local w = x1 - x0
                local score = w * pred.confidence - pen - joins * 0.05 * w
                -- an x-height letter as tall as a capital is a misreading
                if X_HEIGHT[pred.char] and info.bbox.h > line_h * 0.62 then score -= 0.1 * w end
                if not whole and PUNCT[pred.char] then
                    -- but for a hyphen touching a digit ("2026-10"): flat,
                    -- low and in the middle of the line
                    local tb = info.bbox
                    local mid = tb.y + tb.h / 2.0 - info.line_top
                    local hyphen = (pred.char == "-" or pred.char == "." or pred.char == "_") and tb.w >= tb.h * 1.5 and
                        tb.h < line_h * 0.2 and
                        mid > line_h * 0.3 and mid < line_h * 0.75
                    if not hyphen then score -= STROKE_COST * w end
                elseif not whole and STROKE[pred.char] then
                    local stem_ok = STEM[pred.char] and a.implausible and z.implausible
                    if not stem_ok and pred.char ~= "1" then score -= STROKE_COST * w end
                end
                if best[i] + score > best[j] then
                    best[j] = best[i] + score
                    from[j] = i
                    reading[j] = {pred = pred, info = info}
                end
            end
        end
    end
    local out = []
    local j = n
    while j > 0 do
        out[] = reading[j]
        j = from[j]
    end
    return list.reversed(out)
end

local function resolve_image(source)
    if type(source) == "string" then
        return image.load(source)
    elseif type(source) == "table" and source.width and source.height and source.data then
        return source
    end
    return error("ocr: expected file path (string) or Image object")
end

-- the glyphs are learned about 26 pixels a line: text much smaller than
-- that is enlarged first (the factor, 1 when the text is large enough)
const TARGET_LINE = 26
local function upscale_factor(img, opts)
    local probe = preprocess.run(img, opts.preprocess_opts or opts)
    local hs = []
    for _, l in segment.lines(probe, opts.segment_opts or opts) do
        if l.bbox.h >= 4 then hs[] = l.bbox.h end
    end
    if len(hs) == 0 then return 1 end
    local h = sort.sorted(hs)[len(hs) // 2]
    if h >= 20 then return 1 end
    return math.min(4, math.ceil(TARGET_LINE / (h * 1.0)))
end

local function unscale_box(b, k)
    local x0 = b.x // k
    local y0 = b.y // k
    return {x = x0, y = y0, w = math.max(1, (b.x + b.w + k - 1) // k - x0), h = math.max(1, (b.y + b.h + k - 1) // k - y0)}
end

-- ocr.recognize(source [, opts]) → { text, confidence, lines, words, chars, preprocessed }|error
-- opts.upscale: the factor small text is enlarged by (default: chosen from
-- the line height; 1 never enlarges)
function M.recognize(source, opts)
    opts = opts or {}
    local raw_img = resolve_image(source)?
    local k = opts.upscale or (opts.preprocess ~= false and upscale_factor(raw_img, opts) or 1)
    if k > 1 then raw_img = preprocess.upscale(raw_img, k) end
    local proc_img = raw_img
    if opts.preprocess ~= false then
        proc_img = preprocess.run(raw_img, opts.preprocess_opts or opts)
    end

    local mdl = opts.model or model.builtin()
    if opts.mode == "mlp" and not mdl.mlp_trained then
        mdl:train(opts.train_opts)
    end

    local page = segment.page(proc_img, opts.segment_opts or opts)
    local out_lines = []
    local all_words = []
    local all_chars = []
    local line_texts = []
    local total_conf_sum = 0.0
    local total_char_count = 0

    for _, line in page.lines do
        -- the usual width of a character in the line
        local widths = []
        for _, word in line.words do
            for _, ch in word.chars do widths[] = ch.bbox.w end
        end
        local line_ref_w = math.max(2, len(widths) > 0 and list.median(widths) or 2)
        local word_entries = []
        local word_texts = []
        local line_chars = []
        local line_conf_sum = 0.0

        for _, word in line.words do
            local char_entries = []
            local char_strs = []
            local word_conf_sum = 0.0

            local pieces = read_word(mdl, proc_img, word.chars, opts, line_ref_w)?
            for _, piece in pieces do
                local pred = piece.pred
                local ch_info = piece.info
                local ch_entry = {
                    char = pred.char,
                    confidence = pred.confidence,
                    bbox = ch_info.bbox,
                    candidates = pred.candidates,
                }
                char_entries[] = ch_entry
                line_chars[] = ch_entry
                all_chars[] = ch_entry
                char_strs[] = pred.char
                word_conf_sum += pred.confidence
                line_conf_sum += pred.confidence
                total_conf_sum += pred.confidence
                total_char_count += 1
            end

            local w_text = string.join(char_strs, "")
            local w_conf = (len(char_entries) > 0) and (word_conf_sum / len(char_entries)) or 0.0
            local w_entry = {
                text = w_text,
                confidence = w_conf,
                bbox = word.bbox,
                chars = char_entries,
            }
            word_entries[] = w_entry
            all_words[] = w_entry
            word_texts[] = w_text
        end

        -- case, digits against letters, I/l: from the line and the word
        if opts.context ~= false then
            context.fix_line(word_entries)
            word_texts = []
            for _, w in word_entries do word_texts[] = w.text end
        end
        local l_text = string.join(word_texts, " ")
        local l_conf = (len(line_chars) > 0) and (line_conf_sum / len(line_chars)) or 0.0
        out_lines[] = {
            text = l_text,
            confidence = l_conf,
            bbox = line.bbox,
            words = word_entries,
            chars = line_chars,
        }
        line_texts[] = l_text
    end

    -- the boxes in the coordinates of the image given
    if k > 1 then
        for _, l in out_lines do l.bbox = unscale_box(l.bbox, k) end
        for _, w in all_words do w.bbox = unscale_box(w.bbox, k) end
        for _, c in all_chars do c.bbox = unscale_box(c.bbox, k) end
    end

    local full_text = string.join(line_texts, "\n")
    local overall_conf = (total_char_count > 0) and (total_conf_sum / total_char_count) or 0.0

    return {
        text = full_text,
        confidence = overall_conf,
        lines = out_lines,
        words = all_words,
        chars = all_chars,
        preprocessed = proc_img,
    }
end

-- ocr.read(source [, opts]) → string|error
function M.read(source, opts)
    local res = M.recognize(source, opts)?
    return res.text
end

-- Engine object for stateful OCR configuration, custom fonts, and training
local Engine = {}

function Engine.read(self, source, opts)
    local merged = {}
    for k, v in self.opts do merged[k] = v end
    if opts then
        for k, v in opts do merged[k] = v end
    end
    merged.model = self.model
    return M.read(source, merged)
end

function Engine.recognize(self, source, opts)
    local merged = {}
    for k, v in self.opts do merged[k] = v end
    if opts then
        for k, v in opts do merged[k] = v end
    end
    merged.model = self.model
    return M.recognize(source, merged)
end

function Engine.register_font(self, font_obj, opts)
    self.model:register_font(font_obj, opts)
    return self
end

-- engine:register_ttf(font_or_path [, opts]) → engine|error: the engine also
-- learns this TrueType font (the font of the documents it will read)
function Engine.register_ttf(self, source, opts)
    self.model:register_ttf(source, opts)?
    return self
end

function Engine.add_sample(self, label, img_or_ascii, opts)
    local img = img_or_ascii
    if type(img_or_ascii) == "string" then
        img = image.from_ascii(img_or_ascii, opts)
    end
    self.model:add_sample(label, img, opts)
    return self
end

function Engine.train(self, opts)
    return self.model:train(opts)
end

function Engine.save_model(self, file_path)
    return self.model:save(file_path)
end

-- ocr.new_engine([opts]) → Engine
function M.new_engine(opts)
    opts = opts or {}
    local eng = {}
    eng.opts = opts
    eng.model = opts.model or model.new(opts)
    for name, fn in Engine do
        eng[name] = fn
    end
    return eng
end

return M
