local Font = {}

-- font_obj:chars() → sorted array of supported character strings
function Font.chars(self)
    local out = []
    for k, _ in self.glyphs do
        out[] = k
    end
    sort.sort(out)
    return out
end

-- font_obj:set_glyph(ch, rows_or_ascii) → registers or overrides a character glyph
function Font.set_glyph(self, ch, rows_or_ascii)
    if type(rows_or_ascii) == "string" then
        local lines = string.splitlines(rows_or_ascii)
        local cleaned = []
        for _, line in lines do
            if line ~= "" then
                cleaned[] = line
            end
        end
        self.glyphs[ch] = cleaned
    else
        self.glyphs[ch] = rows_or_ascii
    end
    return self
end

-- font_obj:glyph_image(ch [, opts]) → Image of a single character
function Font.glyph_image(self, ch, opts)
    opts = opts or {}
    local rows = self.glyphs[ch]
    if not rows then
        return error(`font.glyph_image: unknown character '${ch}'`)
    end
    local scale = opts.scale or 2
    local pad = opts.pad
    if pad == nil then pad = 1 end
    local bold = opts.bold or false
    local h = len(rows)
    local w = len(rows[0])
    local img = image.new(w * scale + pad * 2, h * scale + pad * 2, 255)
    local iw = img.width
    local ih = img.height
    local data = img.data
    local extra = bold and 1 or 0
    for y = 0, h - 1 do
        local row = rows[y]
        for x = 0, w - 1 do
            local c = string.byte(row, x + 1)
            -- ink: # @ 1 * and + (half coverage in glyphs.sea)
            if c == 35 or c == 64 or c == 49 or c == 42 or c == 43 then
                for sy = 0, scale - 1 + extra do
                    local py = pad + y * scale + sy
                    if py < ih then
                        for sx = 0, scale - 1 + extra do
                            local px = pad + x * scale + sx
                            if px < iw then data[py * iw + px] = 0 end
                        end
                    end
                end
            end
        end
    end
    return img
end

-- font_obj:render(text [, opts]) → Image with rendered single-line or multi-line text
function Font.render(self, text, opts)
    opts = opts or {}
    local scale = opts.scale or 2
    local char_spacing = opts.char_spacing or (scale * 2)
    local space_width = opts.space_width or (scale * 4)
    local line_spacing = opts.line_spacing or (scale * 3)
    local margin = opts.margin or (scale * 3)
    local bold = opts.bold or false
    local fg = opts.fg or 0
    local bg = opts.bg or 255

    local lines = string.splitlines(text)
    if len(lines) == 0 then
        lines = [""]
    end

    local gw = self.width
    local gh = self.height
    local max_line_px = 0
    for _, line in lines do
        local line_chars = utf8.valid(line) and utf8.chars(line) or string.split(line, "")
        local n_chars = len(line_chars)
        local px = 0
        for i = 1, n_chars do
            local ch = line_chars[i - 1]
            if ch == " " then
                px += space_width
            else
                local rows = self.glyphs[ch]
                px += (rows and len(rows[0]) or gw) * scale
            end
            if i < n_chars then
                px += char_spacing
            end
        end
        if px > max_line_px then
            max_line_px = px
        end
    end

    local total_w = max_line_px + margin * 2
    local total_h = len(lines) * (gh * scale) + (len(lines) - 1) * line_spacing + margin * 2
    if total_w < 8 then total_w = 8 end
    if total_h < 8 then total_h = 8 end

    local img = image.new(total_w, total_h, bg)
    for line_idx = 0, len(lines) - 1 do
        local line = lines[line_idx]
        local cursor_x = margin
        local cursor_y = margin + line_idx * (gh * scale + line_spacing)
        local line_chars = utf8.valid(line) and utf8.chars(line) or string.split(line, "")
        for _, ch in line_chars do
            if ch == " " then
                cursor_x += space_width + char_spacing
            else
                local rows = self.glyphs[ch] or self.glyphs[string.upper(ch)]
                if rows then
                    for gy = 0, len(rows) - 1 do
                        local r_str = rows[gy]
                        for gx = 0, len(r_str) - 1 do
                            local c = string.sub(r_str, gx + 1, gx + 1)
                            if c == "#" or c == "@" or c == "1" or c == "*" or c == "+" then
                                local extra = bold and 1 or 0
                                for sy = 0, scale - 1 + extra do
                                    for sx = 0, scale - 1 + extra do
                                        img:set(cursor_x + gx * scale + sx, cursor_y + gy * scale + sy, fg)
                                    end
                                end
                            end
                        end
                    end
                end
                cursor_x += (rows and len(rows[0]) or gw) * scale + char_spacing
            end
        end
    end

    return img
end

-- font.new([glyph_map [, width, height]]) → Font object
function M.new(glyph_map, width, height)
    local f = {}
    f.width = width or 5
    f.height = height or 7
    f.glyphs = {}
    local src = glyph_map or DEFAULT_GLYPHS
    for k, v in src do
        f.glyphs[k] = v
    end
    for name, fn in Font do
        f[name] = fn
    end
    return f
end

-- font.builtin() → default built-in 5x7 font
local default_font_instance = nil
function M.builtin()
    if not default_font_instance then
        default_font_instance = M.new(DEFAULT_GLYPHS, 5, 7)
    end
    return default_font_instance
end
M["default"] = M.builtin

-- font.render(text [, opts]) → Image using the default font (or opts.font)
function M.render(text, opts)
    opts = opts or {}
    local f = opts.font or M.builtin()
    return f:render(text, opts)
end

return M
